# OpenAI-compatible vision-language model endpoint
BASE_URL=http://localhost:8000/v1
MODEL=autoglm-phone-9b
API_KEY=EMPTY
DEVICE_ID=

# Runtime limits
MAX_STEPS=100
MAX_RUNTIME_SECONDS=900
MAX_TOKENS=3000
MAX_FAILURES=3
MAX_REPEATED_ACTIONS=3
CONTEXT_TURNS=12
MODEL_RETRIES=2
OBSERVATION_RETRIES=2
TRAJECTORY_DIR=runs

# Lazy deterministic app launch
APP_LAUNCH_TIMEOUT_SECONDS=15

# Verification and recovery
VERIFICATION_RETRIES=1
VERIFICATION_THRESHOLD=0.002
MAX_RECOVERIES=8
RECOVERY_ATTEMPTS=2

# Model sampling and transport
TEMPERATURE=0
TOP_P=0.85
FREQUENCY_PENALTY=0.0
MODEL_TIMEOUT=120
MODEL_RETRY_BACKOFF=1
CAPTURE_USAGE=1

# Optional cost estimate shown by the Web Console (price per 1 million tokens)
INPUT_PRICE_PER_1M_TOKENS=0
OUTPUT_PRICE_PER_1M_TOKENS=0
COST_CURRENCY=CNY

# Text input timing (seconds)
KEYBOARD_SWITCH_DELAY=0.5
TEXT_CLEAR_DELAY=0.35
TEXT_INPUT_DELAY=0.5
KEYBOARD_RESTORE_DELAY=0.5

# Device action timing (seconds)
TAP_DELAY=0.8
DOUBLE_TAP_DELAY=0.8
DOUBLE_TAP_INTERVAL=0.12
LONG_PRESS_DELAY=0.8
SWIPE_DELAY=0.8
BACK_DELAY=0.8
HOME_DELAY=0.8
LAUNCH_DELAY=1.2
ADB_RESTART_DELAY=2.0
SERVER_RESTART_DELAY=1.0

# Local Web Console
WEB_HOST=127.0.0.1
WEB_PORT=8765
